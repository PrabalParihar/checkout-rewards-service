{
  "name": "checkout-rewards-service",
  "version": "1.0.0",
  "description": "Checkout and rewards backend: carts, idempotent checkout, inventory and milestone coupons",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-timeout=5000 test/*.test.ts",
    "demo": "bash scripts/demo.sh"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
